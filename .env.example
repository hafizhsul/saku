# Salin ke .env.local bila perlu (file ini hanya dokumentasi).
# Tanpa semua variabel di bawah, app + server tetap jalan memakai
# database file lokal (users.json) dan JWT kustom — nol konfigurasi.

# --- Client (Expo, prefix EXPO_PUBLIC_ wajib) ---
#EXPO_PUBLIC_API_URL=http://localhost:4000
#EXPO_PUBLIC_FIREBASE_API_KEY=
#EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
#EXPO_PUBLIC_FIREBASE_PROJECT_ID=
#EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Server (node server/auth-server.js) ---
#PORT=4000
#AUTH_SECRET=isi-rahasia-produksi
# Aktifkan Firestore + verifikasi Firebase ID token:
#FIREBASE_PROJECT_ID=
# Salah satu kredensial Admin SDK:
#FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
#GOOGLE_APPLICATION_CREDENTIALS=/path/service-account.json
# Atau emulator (tanpa kredensial asli):
#FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
